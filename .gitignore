venv/
__pycache__/

# Secrets — .env.example is committed as the template, real values never are.
.env
.env.local
.env.*.local
!.env.example

*.pyc
.pytest_cache/
.DS_Store
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
outputs/graphs/*
outputs/reports/*
!outputs/graphs/.gitkeep
!outputs/reports/.gitkeep

# Frontend (Phase 5) — frontend/ also has its own .gitignore
frontend/node_modules/
frontend/dist/
frontend/*.local
