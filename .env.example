# Copy to `.env` (gitignored) for local overrides, or paste these into your
# host's environment/secret manager in production.
#
# Every variable here is optional: anything unset falls back to config.yaml.
# Names are config.py field names upper-cased. Lists accept comma-separated
# values or a JSON array.

# --- Deployment ------------------------------------------------------------

# Postgres connection string. Unset (the default) => the API serves from
# yfinance + the parquet cache. Set => Phase 4.8's Postgres repositories.
# SECRET — never commit a real value.
# DATABASE_URL=postgresql://app:app@localhost:5432/stockdep

# Origins allowed to call the API. In production this is the deployed Vercel
# origin; without it the browser blocks every request from the frontend.
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# DEBUG locally, INFO in production.
# LOG_LEVEL=INFO

# Sentry DSN for error/performance monitoring + log forwarding. Unset (the
# default) => Sentry is never initialized. Not a traditional secret (DSNs
# are meant to be safe in client-side code too), but left unset here to keep
# local dev/CI free of Sentry noise by default.
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>


# Port to bind. Render/Fly inject this automatically; defaults to 8000.
# PORT=8000

# Alternate config.yaml location (e.g. a mounted file in a container).
# CONFIG_PATH=config.yaml

# --- Analysis parameters (config.yaml holds the working defaults) -----------

# ANCHORS=NVDA,AAPL,TSM,ASML
# LOOKBACK_DAYS=365
# TOP_N=10
# CORRELATION_THRESHOLD=0.5
# ROLLING_WINDOW=60
# MARKET_PROXY_TICKER=^GSPC
# PRICE_CACHE_TTL_SECONDS=21600
