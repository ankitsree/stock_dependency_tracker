# Everything here is sent to the Docker daemon as build context before the
# build starts, so excluding the big directories keeps builds fast and the
# image small. The frontend is excluded outright — it deploys to Vercel, not
# into this image.

.git/
.gitignore

venv/
__pycache__/
*.pyc
*.pyo

.mypy_cache/
.ruff_cache/
.pytest_cache/

frontend/
docs/
tests/
outputs/
data/

.env
.env.*
!.env.example

Makefile
.pre-commit-config.yaml
.claude/
*.md
.DS_Store
Dockerfile
docker-compose.yml
